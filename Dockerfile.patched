# Overlay OpenAPI plus the route modules whose docstrings feed the spec.
# Do not COPY the whole shelfmark/ tree: fork main may be newer than this digest.
FROM ghcr.io/calibrain/shelfmark@sha256:dae6e16fc40f42b2558d9f47d05e4ba7a7d268d23365a7c3eba266055249a124
COPY shelfmark/core/openapi.py /app/shelfmark/core/openapi.py
COPY shelfmark/core/activity_routes.py /app/shelfmark/core/activity_routes.py
COPY shelfmark/core/admin_settings_routes.py /app/shelfmark/core/admin_settings_routes.py
COPY shelfmark/core/release_inspect_routes.py /app/shelfmark/core/release_inspect_routes.py
COPY shelfmark/core/request_routes.py /app/shelfmark/core/request_routes.py
COPY shelfmark/core/self_user_routes.py /app/shelfmark/core/self_user_routes.py
COPY shelfmark/main.py /app/shelfmark/main.py
